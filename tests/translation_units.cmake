execute_process(
    COMMAND "${COMPILER}" --target=zos-hlasm -S "${LIBRARY_SOURCE}" -o "${LIBRARY_ASM}"
    RESULT_VARIABLE library_result ERROR_VARIABLE library_error
)
if(NOT library_result EQUAL 0)
    message(FATAL_ERROR "library translation unit failed: ${library_error}")
endif()
execute_process(
    COMMAND "${COMPILER}" --target=zos-hlasm -S "${PROGRAM_SOURCE}" -o "${PROGRAM_ASM}"
    RESULT_VARIABLE program_result ERROR_VARIABLE program_error
)
if(NOT program_result EQUAL 0)
    message(FATAL_ERROR "program translation unit failed: ${program_error}")
endif()
file(READ "${LIBRARY_ASM}" library)
file(READ "${PROGRAM_ASM}" program)
foreach(required "ENTRY" "ALIAS    C'translation_unit_answer'" "MAIN=NO")
    string(FIND "${library}" "${required}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "library unit lacks '${required}'")
    endif()
endforeach()
foreach(global_name shared_initialized shared_zero)
    string(FIND "${library}" "ALIAS    C'${global_name}'" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "library unit does not define global '${global_name}'")
    endif()
endforeach()
string(FIND "${library}" "ALIAS    C'private_helper'" library_static_alias)
if(NOT library_static_alias EQUAL -1)
    message(FATAL_ERROR "library unit exposes private_helper")
endif()
string(FIND "${library}" "ALIAS    C'private_value'" library_static_data_alias)
if(NOT library_static_data_alias EQUAL -1)
    message(FATAL_ERROR "library unit exposes private_value")
endif()
string(FIND "${library}" "MAIN=YES" library_main)
if(NOT library_main EQUAL -1)
    message(FATAL_ERROR "library unit incorrectly contains an LE main entry")
endif()
foreach(required "EXTRN" "ALIAS    C'translation_unit_answer'" "MAIN=YES")
    string(FIND "${program}" "${required}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "program unit lacks '${required}'")
    endif()
endforeach()
foreach(global_name shared_initialized shared_zero)
    string(FIND "${program}" "ALIAS    C'${global_name}'" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "program unit does not reference global '${global_name}'")
    endif()
endforeach()
string(FIND "${program}" "ALIAS    C'private_helper'" program_static_alias)
if(NOT program_static_alias EQUAL -1)
    message(FATAL_ERROR "program unit exposes private_helper")
endif()
